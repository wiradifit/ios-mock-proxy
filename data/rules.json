[
  {
    "id": "rule_sample_1",
    "name": "User Profile API",
    "enabled": true,
    "method": "GET",
    "path": "/api/v1/user/profile",
    "matchType": "exact",
    "statusCode": 200,
    "delay": 150,
    "headers": {
      "Content-Type": "application/json"
    },
    "body": "{\n  \"status\": \"success\",\n  \"data\": {\n    \"user_id\": \"usr_1024\",\n    \"name\": \"Sarah Connor\",\n    \"email\": \"sarah@example.com\",\n    \"role\": \"developer\",\n    \"theme\": \"dark\",\n    \"notifications_enabled\": true\n  }\n}"
  },
  {
    "id": "rule_sample_2",
    "name": "Products Catalog List",
    "enabled": true,
    "method": "GET",
    "path": "/api/v1/products",
    "matchType": "prefix",
    "statusCode": 200,
    "delay": 120,
    "headers": {
      "Content-Type": "application/json"
    },
    "body": "{\n  \"status\": \"success\",\n  \"count\": 2,\n  \"items\": [\n    {\n      \"id\": 1,\n      \"title\": \"Ergonomic Mechanical Keyboard\",\n      \"category\": \"Accessories\",\n      \"price\": 129.99,\n      \"in_stock\": true\n    },\n    {\n      \"id\": 2,\n      \"title\": \"Ultra-Wide 4K Monitor\",\n      \"category\": \"Monitors\",\n      \"price\": 499.99,\n      \"in_stock\": true\n    }\n  ]\n}"
  }
]